<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cartera Sana</title>
  <link rel="stylesheet" href="/vendor/@fontsource/inter/400.css" />
  <link rel="stylesheet" href="/vendor/@fontsource/inter/500.css" />
  <link rel="stylesheet" href="/vendor/@fontsource/inter/600.css" />
  <link rel="stylesheet" href="/vendor/@fontsource/inter/700.css" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/vendor/lucide/dist/umd/lucide.js"></script>
</head>
  <body>
    <div class="app-shell">
      <header class="hero">
        <div class="hero-content">
          <p class="eyebrow">Cartera Sana</p>
          <h1>Hola, Marco</h1>
          <p>Aquí está el resumen de tus finanzas de <%= dashboard.currentMonthLabel || '' %></p>
        </div>
        <div class="hero-card">
          <p>Saldo disponible</p>
          <h2><%= formatCurrency(dashboard.balance || 0, currency) %></h2>
          <p class="muted">Balance del mes actual</p>
        </div>
      </header>

      <nav class="tabs">
        <a class="tab-link <%= activeView === 'overview' ? 'active' : '' %>" href="/?view=overview">
          <i data-lucide="home"></i> Inicio
        </a>
        <a class="tab-link <%= activeView === 'plan' ? 'active' : '' %>" href="/?view=plan">
          <i data-lucide="list"></i> Planificación
        </a>
        <a class="tab-link <%= activeView === 'movements' ? 'active' : '' %>" href="/?view=movements">
          <i data-lucide="arrow-right-left"></i> Movimientos
        </a>
        <a class="tab-link <%= activeView === 'debts' ? 'active' : '' %>" href="/?view=debts">
          <i data-lucide="credit-card"></i> Deudas
        </a>
        <a class="tab-link <%= activeView === 'goals' ? 'active' : '' %>" href="/?view=goals">
          <i data-lucide="target"></i> Metas
        </a>
        <a class="tab-link <%= activeView === 'accounts' ? 'active' : '' %>" href="/?view=accounts">
          <i data-lucide="building"></i> Cuentas
        </a>
      </nav>

      <!-- ============================================ -->
      <!-- VISTA: INICIO (OVERVIEW)                     -->
      <!-- ============================================ -->
      <% if (activeView === 'overview') { %>
        
        <!-- Tarjetas de resumen -->
        <section class="summary-grid">
          <article class="card">
            <p class="label"><i data-lucide="trending-up"></i> Ingresos</p>
            <h3><%= formatCurrency(dashboard.incomeTotal || 0, currency) %></h3>
          </article>
          <article class="card">
            <p class="label"><i data-lucide="trending-down"></i> Gastos</p>
            <h3><%= formatCurrency(dashboard.expenseTotal || 0, currency) %></h3>
          </article>
          <article class="card">
            <p class="label"><i data-lucide="bar-chart-3"></i> Planeado</p>
            <h3><%= formatCurrency(dashboard.plannedBalance || 0, currency) %></h3>
          </article>
          <article class="card">
            <p class="label"><i data-lucide="target"></i> Meta ahorro</p>
            <h3><%= formatCurrency(dashboard.settings?.monthlySavingsGoal || 0, currency) %></h3>
          </article>
        </section>

        <!-- Métricas Financieras -->
        <section class="section-grid compact-bottom">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="piggy-bank"></i> Tu salud financiera</h2>
              <span>Indicadores clave de este mes</span>
            </div>
            <div class="metrics-grid">
              <div class="metric-item">
                <p class="label">Tasa de Ahorro</p>
                <h3><%= (dashboard.metrics?.savingsRate || 0).toFixed(1) %>%</h3>
                <p class="muted"><%= (dashboard.metrics?.savingsRate || 0) > 20 ? 'Excelente' : (dashboard.metrics?.savingsRate || 0) > 10 ? 'Bien' : 'Mejorable' %></p>
              </div>
              <div class="metric-item">
                <p class="label">Deuda / Ingresos</p>
                <h3><%= (dashboard.metrics?.debtToIncome || 0).toFixed(1) %>%</h3>
                <p class="muted"><%= (dashboard.metrics?.debtToIncome || 0) < 30 ? 'Saludable' : 'Alto' %></p>
              </div>
              <div class="metric-item">
                <p class="label">Fondo Emergencia</p>
                <h3><%= (dashboard.metrics?.emergencyFundMonths || 0).toFixed(1) %></h3>
                <p class="muted"><%= (dashboard.metrics?.emergencyFundMonths || 0) >= 3 ? 'Adecuado' : 'Bajo' %></p>
              </div>
              <div class="metric-item">
                <p class="label">Ahorro Mensual</p>
                <h3><%= formatCurrency(dashboard.metrics?.monthlySavings || 0, currency) %></h3>
                <p class="muted"><%= (dashboard.metrics?.monthlySavings || 0) > 0 ? 'Positivo' : 'Negativo' %></p>
              </div>
            </div>
          </div>
        </section>

        <!-- Resumen y próximos cargos -->
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="trending-up"></i> Resumen del mes</h2>
              <span>Panorama general</span>
            </div>
            <div class="highlight-list">
              <div class="highlight-item">
                <span>Ingresos programados</span>
                <strong><%= formatCurrency(dashboard.plannedIncomeTotal || 0, currency) %></strong>
              </div>
              <div class="highlight-item">
                <span>Gastos fijos y suscripciones</span>
                <strong><%= formatCurrency(dashboard.plannedExpenseTotal || 0, currency) %></strong>
              </div>
              <div class="highlight-item">
                <span>Disponible después de lo planeado</span>
                <strong><%= formatCurrency(dashboard.projectedBalance || 0, currency) %></strong>
              </div>
              <div class="highlight-item">
                <span>Meta de ahorro mensual</span>
                <strong><%= formatCurrency(dashboard.settings?.monthlySavingsGoal || 0, currency) %></strong>
              </div>
            </div>
            <p class="hint">
              <i data-lucide="lightbulb"></i>
              <% if ((dashboard.savingsGap || 0) >= 0) { %>
                Te faltan <strong><%= formatCurrency(dashboard.savingsGap || 0, currency) %></strong> para alcanzar tu meta
              <% } else { %>
                Estás <strong><%= formatCurrency(Math.abs(dashboard.savingsGap || 0), currency) %></strong> por encima de tu meta
              <% } %>
            </p>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="bell"></i> Próximos cargos</h2>
              <span>Lo que viene</span>
            </div>
            <% if (dashboard.upcomingPlanned && dashboard.upcomingPlanned.length > 0) { %>
              <% dashboard.upcomingPlanned.forEach((item) => { %>
                <div class="plan-item compact">
                  <div>
                    <strong><%= item.name %></strong>
                    <p class="muted">Día <%= item.dueDay %> · <%= item.category %></p>
                  </div>
                  <span class="tag <%= item.type === 'income' ? 'positive' : 'negative' %>"><%= formatCurrency(item.amount, currency) %></span>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin cargos programados</p>
            <% } %>
          </div>
        </section>

        <!-- Gastos por categoría y últimos movimientos -->
        <section class="section-grid">
          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="bar-chart-3"></i> Gastos por categoría</h2>
              <span>Este mes</span>
            </div>
            <% if (dashboard.categoryBreakdown && dashboard.categoryBreakdown.length > 0) { %>
              <svg viewBox="0 0 320 140" class="chart-svg" role="img" aria-label="Gráfica de gastos">
                <% dashboard.categoryBreakdown.forEach((item, index) => { const height = Math.max(20, (item.amount / dashboard.maxCategoryAmount) * 100); %>
                  <rect x="<%= 20 + index * 58 %>" y="<%= 120 - height %>" width="36" height="<%= height %>" rx="6" fill="<%= ['#5b8def', '#a371f7', '#58a6ff', '#3fb950', '#d29922'][index % 5] %>"></rect>
                  <text x="<%= 20 + index * 58 + 18 %>" y="132" text-anchor="middle" font-size="10" fill="#9ba3af"><%= item.category.substring(0, 8) %></text>
                <% }) %>
              </svg>
              <% dashboard.categoryBreakdown.forEach((item, index) => { %>
                <div class="breakdown-item">
                  <div class="breakdown-meta">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <div style="width: 8px; height: 8px; border-radius: 50%; background: <%= ['#5b8def', '#a371f7', '#58a6ff', '#3fb950', '#d29922'][index % 5] %>;"></div>
                      <strong><%= item.category %></strong>
                    </div>
                    <span><%= formatCurrency(item.amount, currency) %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin gastos este mes</p>
            <% } %>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="clock"></i> Últimos movimientos</h2>
              <span>Recientes</span>
            </div>
            <% if (dashboard.transactions && dashboard.transactions.length > 0) { %>
              <% dashboard.transactions.slice(0, 6).forEach((transaction) => { %>
                <div class="transaction-item" data-id="<%= transaction.id %>">
                  <div>
                    <strong><%= transaction.description %></strong>
                    <p class="muted"><%= transaction.category %> · <%= transaction.date %></p>
                  </div>
                  <div class="transaction-actions">
                    <span class="amount <%= transaction.type === 'income' ? 'positive' : 'negative' %>">
                      <%= transaction.type === 'income' ? '+' : '-' %><%= formatCurrency(transaction.amount, currency) %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin movimientos aún</p>
            <% } %>
          </div>
        </section>

        <!-- Presupuestos -->
        <section class="section-grid compact-bottom">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="target"></i> Presupuestos por categoría</h2>
              <span>Límites vs. gasto real</span>
            </div>
            
            <form action="/budgets" method="POST" class="inline-form">
              <input type="text" name="category" placeholder="Categoría" required />
              <input type="number" step="0.01" name="amount" placeholder="Presupuesto" required />
              <button type="submit"><i data-lucide="plus"></i> Agregar</button>
            </form>
            
            <% if (dashboard.budgets && Object.keys(dashboard.budgets).length > 0) { %>
              <% Object.entries(dashboard.budgets).forEach(([category, budget]) => { %>
                <% const spent = (dashboard.categoryBreakdown || []).find(c => c.category === category)?.amount || 0; %>
                <% const percent = budget > 0 ? (spent / budget) * 100 : 0; %>
                <div class="budget-item">
                  <div class="budget-head">
                    <strong><%= category %></strong>
                    <span><%= formatCurrency(spent, currency) %> / <%= formatCurrency(budget, currency) %></span>
                    <button class="btn-delete-budget" data-category="<%= category %>" title="Eliminar"><i data-lucide="trash-2"></i></button>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= Math.min(100, percent) %>%; 
                         background: <%= percent > 90 ? '#f85149' : percent > 70 ? '#d29922' : '#3fb950' %>">
                    </div>
                  </div>
                  <span class="budget-status <%= percent > 90 ? 'danger' : percent > 70 ? 'warning' : 'success' %>">
                    <%= percent > 90 ? 'Excedido' : percent > 70 ? 'Cerca' : 'En línea' %> · <%= percent.toFixed(0) %>%
                  </span>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">No tienes presupuestos definidos. ¡Agrega uno arriba!</p>
            <% } %>
          </div>
        </section>

        <!-- Configuración y Exportar -->
        <section class="section-grid compact-bottom">
          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="settings"></i> Configuración</h2>
              <span>Ajusta tus preferencias</span>
            </div>
            <form action="/settings" method="POST" class="stacked-form compact">
              <div class="form-row">
                <label>
                  Tu nombre
                  <input type="text" name="ownerName" value="<%= dashboard.settings?.ownerName || '' %>" />
                </label>
                <label>
                  Meta mensual
                  <input type="number" step="0.01" name="monthlySavingsGoal" value="<%= dashboard.settings?.monthlySavingsGoal || 0 %>" />
                </label>
              </div>
              <label>
                Moneda
                <select name="currency">
                  <option value="MXN" <%= currency === 'MXN' ? 'selected' : '' %>>MXN - Peso Mexicano</option>
                  <option value="USD" <%= currency === 'USD' ? 'selected' : '' %>>USD - Dólar</option>
                  <option value="EUR" <%= currency === 'EUR' ? 'selected' : '' %>>EUR - Euro</option>
                </select>
              </label>
              <button type="submit"><i data-lucide="save"></i> Guardar cambios</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="download"></i> Exportar datos</h2>
              <span>Descarga tus reportes</span>
            </div>
            <div class="export-buttons">
              <a href="/api/export/excel" class="export-btn excel"><i data-lucide="file-text"></i> Excel</a>
              <a href="/api/export/pdf" class="export-btn pdf"><i data-lucide="file-text"></i> PDF</a>
            </div>
          </div>
        </section>
      <% } %>

      <!-- ============================================ -->
      <!-- VISTA: PLANIFICACIÓN                        -->
      <!-- ============================================ -->
      <% if (activeView === 'plan') { %>
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="calendar"></i> Programar ingreso o gasto</h2>
              <span>Define tus movimientos recurrentes</span>
            </div>
            <form action="/planned" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  Tipo
                  <select name="type">
                    <option value="income">Ingreso mensual</option>
                    <option value="expense">Gasto fijo / suscripción</option>
                  </select>
                </label>
                <label>
                  Nombre
                  <input type="text" name="name" placeholder="Ej. Sueldo, Netflix, Renta" required />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Monto
                  <input type="number" step="0.01" name="amount" required />
                </label>
                <label>
                  Categoría
                  <input type="text" name="category" placeholder="Ej. Trabajo, Suscripción" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Frecuencia
                  <select name="frequency">
                    <option value="monthly">Mensual</option>
                    <option value="biweekly">Quincenal</option>
                    <option value="once">Una sola vez</option>
                  </select>
                </label>
                <label>
                  Día de cobro/pago
                  <input type="number" min="1" max="31" name="dueDay" value="1" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Método de Pago
                  <select name="paymentMethod">
                    <option value="Automático">Automático</option>
                    <option value="Manual">Manual</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                  </select>
                </label>
                <label>
                  Nota
                  <input type="text" name="notes" placeholder="Opcional" />
                </label>
              </div>
              <button type="submit"><i data-lucide="save"></i> Guardar programación</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="list"></i> Tu plan mensual</h2>
              <span>Programados</span>
            </div>
            <% if (dashboard.plannedItems && dashboard.plannedItems.length > 0) { %>
              <% dashboard.plannedItems.forEach((item) => { %>
                <div class="plan-item" data-id="<%= item.id %>">
                  <div>
                    <strong><%= item.name %></strong>
                    <p class="muted"><%= item.category %> · <%= item.frequency === 'biweekly' ? 'Quincenal' : item.frequency === 'monthly' ? 'Mensual' : 'Una vez' %> · día <%= item.dueDay %></p>
                  </div>
                  <div class="transaction-actions">
                    <span class="tag <%= item.type === 'income' ? 'positive' : 'negative' %>"><%= formatCurrency(item.amount, currency) %></span>
                    <button class="btn-edit-plan" data-id="<%= item.id %>" title="Editar"><i data-lucide="edit"></i></button>
                    <button class="btn-delete-plan" data-id="<%= item.id %>" title="Eliminar"><i data-lucide="trash-2"></i></button>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">No hay programaciones aún</p>
            <% } %>
          </div>
        </section>
      <% } %>

      <!-- ============================================ -->
      <!-- VISTA: MOVIMIENTOS                          -->
      <!-- ============================================ -->
      <% if (activeView === 'movements') { %>
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="arrow-right-left"></i> Registrar movimiento</h2>
              <span>Ingresos, gastos y pagos</span>
            </div>
            <form action="/transactions" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  Tipo
                  <select name="type">
                    <option value="income">Ingreso</option>
                    <option value="expense">Gasto</option>
                    <option value="debt_payment">Pago de deuda</option>
                  </select>
                </label>
                <label>
                  Monto
                  <input type="number" step="0.01" name="amount" required />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Descripción
                  <input type="text" name="description" placeholder="Ej. Compra supermercado" required />
                </label>
                <label>
                  Categoría
                  <input type="text" name="category" placeholder="Ej. Alimentación" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Fecha
                  <input type="date" name="date" />
                </label>
                <label>
                  Cuenta
                  <select name="accountId">
                    <% (dashboard.accounts || []).forEach((account) => { %>
                      <option value="<%= account.id %>"><%= account.name %> ($<%= account.balance %>)</option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <div class="form-row">
                <label>
                  Método de Pago
                  <select name="paymentMethod">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                    <option value="Tarjeta Crédito">Tarjeta Crédito</option>
                  </select>
                </label>
                <label>
                  Deuda asociada
                  <select name="linkedDebtId">
                    <option value="">Ninguna</option>
                    <% (dashboard.debts || []).forEach((debt) => { %>
                      <option value="<%= debt.id %>"><%= debt.name %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <label>
                Nota
                <input type="text" name="notes" placeholder="Opcional" />
              </label>
              <button type="submit"><i data-lucide="save"></i> Guardar movimiento</button>
            </form>

            <div class="section-header" style="margin-top: 32px;">
              <h2><i data-lucide="refresh-cw"></i> Transferir entre cuentas</h2>
              <span>Mueve tu dinero</span>
            </div>
            <form action="/transfers" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  De
                  <select name="fromAccount" required>
                    <% (dashboard.accounts || []).forEach((account) => { %>
                      <option value="<%= account.id %>"><%= account.name %></option>
                    <% }) %>
                  </select>
                </label>
                <label>
                  A
                  <select name="toAccount" required>
                    <% (dashboard.accounts || []).forEach((account) => { %>
                      <option value="<%= account.id %>"><%= account.name %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
              <div class="form-row">
                <label>
                  Monto
                  <input type="number" step="0.01" name="amount" required />
                </label>
                <label>
                  Descripción
                  <input type="text" name="description" placeholder="Ej. Ahorro quincenal" />
                </label>
              </div>
              <button type="submit"><i data-lucide="arrow-right-left"></i> Realizar transferencia</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="list"></i> Historial</h2>
              <span>Movimientos registrados</span>
            </div>
            <% if (dashboard.transactions && dashboard.transactions.length > 0) { %>
              <% dashboard.transactions.forEach((transaction) => { %>
                <div class="transaction-item" data-id="<%= transaction.id %>">
                  <div>
                    <strong><%= transaction.description %></strong>
                    <p class="muted"><%= transaction.category %> · <%= transaction.date %></p>
                  </div>
                  <div class="transaction-actions">
                    <span class="amount <%= transaction.type === 'income' ? 'positive' : 'negative' %>">
                      <%= transaction.type === 'income' ? '+' : '-' %><%= formatCurrency(transaction.amount, currency) %>
                    </span>
                    <button class="btn-edit" data-id="<%= transaction.id %>" data-type="transaction" title="Editar"><i data-lucide="edit"></i></button>
                    <button class="btn-delete" data-id="<%= transaction.id %>" data-type="transaction" title="Eliminar"><i data-lucide="trash-2"></i></button>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin movimientos</p>
            <% } %>
          </div>
        </section>
      <% } %>

      <!-- ============================================ -->
      <!-- VISTA: DEUDAS                               -->
      <!-- ============================================ -->
      <% if (activeView === 'debts') { %>
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="credit-card"></i> Agregar deuda</h2>
              <span>Tarjetas, préstamos y créditos</span>
            </div>
            <form action="/debts" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  Nombre
                  <input type="text" name="name" placeholder="Ej. TDC BBVA" required />
                </label>
                <label>
                  Saldo actual
                  <input type="number" step="0.01" name="balance" required />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Límite de crédito
                  <input type="number" step="0.01" name="limit" />
                </label>
                <label>
                  Pago mínimo
                  <input type="number" step="0.01" name="minPayment" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Fecha de vencimiento
                  <input type="date" name="dueDate" />
                </label>
                <label>
                  Interés anual (%)
                  <input type="number" step="0.01" name="interestRate" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Método de Pago Preferido
                  <select name="paymentMethod">
                    <option value="Transferencia">Transferencia</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                    <option value="Automático">Automático</option>
                  </select>
                </label>
                <label>
                  Color
                  <input type="color" name="color" value="#5b8def" />
                </label>
              </div>
              <button type="submit"><i data-lucide="save"></i> Guardar deuda</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="bar-chart-3"></i> Deudas activas</h2>
              <span>Uso de crédito</span>
            </div>
            <% if (dashboard.debts && dashboard.debts.length > 0) { %>
              <% dashboard.debts.forEach((debt) => { %>
                <% const width = debt.limit ? Math.min(100, Math.round((Number(debt.balance || 0) / Number(debt.limit || 1)) * 100)) : 0; %>
                <div class="debt-item" data-id="<%= debt.id %>">
                  <div class="debt-head">
                    <strong><%= debt.name %></strong>
                    <span><%= formatCurrency(debt.balance, currency) %></span>
                    <div class="transaction-actions">
                      <button class="btn-edit-debt" data-id="<%= debt.id %>" title="Editar"><i data-lucide="edit"></i></button>
                      <button class="btn-delete-debt" data-id="<%= debt.id %>" title="Eliminar"><i data-lucide="trash-2"></i></button>
                    </div>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= width %>%; background: <%= debt.color || '#5b8def' %>"></div>
                  </div>
                  <p class="muted">Uso: <%= width %>% · Pago mínimo: <%= formatCurrency(debt.minPayment, currency) %></p>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin deudas registradas</p>
            <% } %>
          </div>
        </section>

        <section class="section-grid compact-bottom">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="calculator"></i> Simulador de amortización</h2>
              <span>¿Cuánto ahorras pagando extra?</span>
            </div>
            <div class="calculator-grid">
              <div class="calculator-inputs">
                <h3>Datos de la deuda</h3>
                <div class="form-row">
                  <label>
                    Saldo
                    <input type="number" id="amortBalance" placeholder="3500" />
                  </label>
                  <label>
                    Interés anual (%)
                    <input type="number" id="amortRate" placeholder="35" />
                  </label>
                </div>
                <div class="form-row">
                  <label>
                    Pago mínimo
                    <input type="number" id="amortMinPayment" placeholder="175" />
                  </label>
                  <label>
                    Pago extra
                    <input type="number" id="amortExtraPayment" value="0" placeholder="500" />
                  </label>
                </div>
                <button onclick="calculateAmortization()" style="width: 100%;"><i data-lucide="calculator"></i> Calcular</button>
              </div>
              
              <div class="calculator-results" id="amortResults" style="display: none;">
                <h3>Resultados</h3>
                <div class="amortization-summary">
                  <div class="summary-item">
                    <span>Meses menos</span>
                    <strong id="amortMonthsSaved">0</strong>
                  </div>
                  <div class="summary-item">
                    <span>Ahorras</span>
                    <strong id="amortInterestSaved">$0</strong>
                  </div>
                  <div class="summary-item">
                    <span>Interés total</span>
                    <strong id="amortTotalInterest">$0</strong>
                  </div>
                </div>
                
                <div class="comparison-highlight" id="amortComparison"></div>
                
                <h4 style="margin-top: 16px; font-size: 0.85rem;">Tabla (primeros 12 meses)</h4>
                <div id="amortScheduleContainer" style="overflow-x: auto; margin-top: 8px;"></div>
              </div>
            </div>
          </div>
        </section>
      <% } %>

      <!-- ============================================ -->
      <!-- VISTA: METAS                                -->
      <!-- ============================================ -->
      <% if (activeView === 'goals') { %>
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="target"></i> Mis metas de ahorro</h2>
              <span>Alcanza tus objetivos</span>
            </div>
            
            <form action="/savings-goals" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  Nombre
                  <input type="text" name="name" placeholder="Ej. Viaje a Cancún" required />
                </label>
                <label>
                  Meta total
                  <input type="number" step="0.01" name="targetAmount" required />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Monto inicial
                  <input type="number" step="0.01" name="currentAmount" value="0" />
                </label>
                <label>
                  Fecha límite
                  <input type="date" name="deadline" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Aportación
                  <input type="number" step="0.01" name="monthlyContribution" placeholder="0" />
                </label>
                <label>
                  Frecuencia de ahorro
                  <select name="savingMethod">
                    <option value="monthly">Mensual</option>
                    <option value="biweekly">Quincenal</option>
                    <option value="weekly">Semanal</option>
                    <option value="daily">Diaria</option>
                  </select>
                </label>
              </div>
              <button type="submit"><i data-lucide="save"></i> Crear meta</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="trending-up"></i> Progreso</h2>
              <span>Metas activas</span>
            </div>
            <% if (dashboard.savingsGoals && dashboard.savingsGoals.length > 0) { %>
              <% dashboard.savingsGoals.forEach(goal => { %>
                <% const percent = goal.targetAmount > 0 ? (goal.currentAmount / goal.targetAmount) * 100 : 0; %>
                <div class="goal-item" data-id="<%= goal.id %>">
                  <div class="goal-head">
                    <strong><%= goal.name %></strong>
                    <span><%= formatCurrency(goal.currentAmount, currency) %> / <%= formatCurrency(goal.targetAmount, currency) %></span>
                    <div class="transaction-actions">
                      <button class="btn-delete-goal" data-id="<%= goal.id %>" title="Eliminar"><i data-lucide="trash-2"></i></button>
                    </div>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= Math.min(100, percent) %>%; background: linear-gradient(90deg, #5b8def, #a371f7)"></div>
                  </div>
                  <p class="muted">
                    <%= percent.toFixed(0) %>% completado
                    <% if (goal.deadline) { %> · <%= new Date(goal.deadline).toLocaleDateString() %><% } %>
                  </p>
                  <form action="/savings-goals/<%= goal.id %>" method="PUT" class="inline-form" onsubmit="return false;">
                    <input type="number" step="0.01" name="addAmount" placeholder="Aportar $" class="goal-contribution" />
                    <button type="submit" class="btn-add-goal" data-id="<%= goal.id %>"><i data-lucide="plus"></i></button>
                  </form>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin metas aún</p>
            <% } %>
          </div>
        </section>

        <section class="section-grid compact-bottom">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="calculator"></i> Calculadora de aportaciones</h2>
              <span>¿Cuánto necesitas ahorrar?</span>
            </div>
            <div class="calculator-grid">
              <div class="calculator-inputs">
                <h3>Datos de tu meta</h3>
                <div class="form-row">
                  <label>
                    Meta total
                    <input type="number" id="calcTarget" placeholder="15000" />
                  </label>
                  <label>
                    Monto actual
                    <input type="number" id="calcCurrent" placeholder="0" value="0" />
                  </label>
                </div>
                <div class="form-row">
                  <label>
                    Fecha límite
                    <input type="date" id="calcDeadline" />
                  </label>
                  <label>
                    Frecuencia
                    <select id="calcFrequency">
                      <option value="monthly">Mensual</option>
                      <option value="biweekly">Quincenal</option>
                      <option value="weekly">Semanal</option>
                      <option value="daily">Diaria</option>
                    </select>
                  </label>
                </div>
                <button onclick="calculateGoal()" style="width: 100%;"><i data-lucide="calculator"></i> Calcular aportación</button>
              </div>
              
              <div class="calculator-results" id="calcResults" style="display: none;">
                <h3>Resultados</h3>
                <div class="result-item">
                  <span>Te falta</span>
                  <strong id="resultRemaining">$0</strong>
                </div>
                <div class="result-item">
                  <span>Tiempo</span>
                  <strong id="resultTime">0 meses</strong>
                </div>
                <div class="result-item">
                  <span>Progreso</span>
                  <strong id="resultProgress">0%</strong>
                </div>
                <div class="result-options">
                  <div class="result-option monthly">
                    <span>Mensual</span>
                    <strong id="resultMonthly">$0</strong>
                  </div>
                  <div class="result-option biweekly">
                    <span>Quincenal</span>
                    <strong id="resultBiweekly">$0</strong>
                  </div>
                  <div class="result-option weekly">
                    <span>Semanal</span>
                    <strong id="resultWeekly">$0</strong>
                  </div>
                  <div class="result-option daily">
                    <span>Diaria</span>
                    <strong id="resultDaily">$0</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      <% } %>

      <!-- ============================================ -->
      <!-- VISTA: CUENTAS                              -->
      <!-- ============================================ -->
      <% if (activeView === 'accounts') { %>
        <section class="section-grid">
          <div class="card wide">
            <div class="section-header">
              <h2><i data-lucide="building"></i> Agregar cuenta</h2>
              <span>Administra tus cuentas</span>
            </div>
            <form action="/accounts" method="POST" class="stacked-form">
              <div class="form-row">
                <label>
                  Nombre
                  <input type="text" name="name" placeholder="Ej. Cuenta de Ahorro" required />
                </label>
                <label>
                  Saldo inicial
                  <input type="number" step="0.01" name="balance" value="0" />
                </label>
              </div>
              <div class="form-row">
                <label>
                  Tipo
                  <select name="type">
                    <option value="cash">Efectivo</option>
                    <option value="debit">Tarjeta Débito</option>
                    <option value="savings">Ahorro</option>
                    <option value="credit">Tarjeta Crédito</option>
                  </select>
                </label>
                <label>
                  Método predeterminado
                  <select name="defaultPaymentMethod">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                    <option value="Tarjeta Débito">Tarjeta Débito</option>
                  </select>
                </label>
              </div>
              <button type="submit"><i data-lucide="save"></i> Crear cuenta</button>
            </form>
          </div>

          <div class="card">
            <div class="section-header">
              <h2><i data-lucide="wallet"></i> Mis cuentas</h2>
              <span>Saldos actuales</span>
            </div>
            <% if (dashboard.accounts && dashboard.accounts.length > 0) { %>
              <% dashboard.accounts.forEach((account) => { %>
                <div class="account-item" data-id="<%= account.id %>">
                  <div class="account-head">
                    <div>
                      <strong><%= account.name %></strong>
                      <p class="muted"><%= account.type %></p>
                    </div>
                    <span class="amount positive"><%= formatCurrency(account.balance, currency) %></span>
                    <div class="transaction-actions">
                      <button class="btn-delete-account" data-id="<%= account.id %>" title="Eliminar"><i data-lucide="trash-2"></i></button>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="muted">Sin cuentas</p>
            <% } %>
          </div>
        </section>
      <% } %>

    </div>

    <!-- Modal para editar -->
    <div id="editModal" class="modal hidden">
      <div class="modal-content">
        <span class="modal-close" onclick="closeModal()">&times;</span>
        <h2 id="modalTitle">Editar</h2>
        <form id="editForm" onsubmit="return false;">
          <input type="hidden" id="editId" />
          <input type="hidden" id="editType" />
          <div id="editFields"></div>
          <button type="submit" onclick="submitEdit()"><i data-lucide="save"></i> Actualizar</button>
        </form>
      </div>
    </div>

    <script src="/scripts.js"></script>
  </body>
</html>